// The whole build program for a HuxerUI application.
//
// `huxerui.rules` arrives through the huxerui dependency, which re-exports it,
// so this file names no package of its own. configure() schedules the
// composable transform (hcg) and the resource compiler (hrc) as build-graph
// edges, and hands this package the scope macros and <typeinfo> that
// `import huxerui;` needs.

import mcpp;
import huxerui.rules;

int main() {
    return huxerui::rules::configure({
        .resources         = "resources",
        // The identifier a store or a launcher knows the application by: the
        // Apple bundle id and the Android application id alike, the project id
        // `huxerui create --id` recorded (CMake's BUNDLE_IDENTIFIER).
        .bundle_identifier = "{{project.id}}",
    }) ? 0 : 1;
}
