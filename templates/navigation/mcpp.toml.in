# c++20, the standard HuxerUI and a CMake application build at. The macOS and
# iOS rows' C++ standard library (`llvm.libcxx`, below) states c++23 itself and
# compiles its own sources at that level (mcpp 2026.9.15.2, mcpp#641).
[package]
name     = "{{project.name}}"
version  = "0.1.0"
standard = "c++20"
platforms = ["linux", "windows", "macos", "ios", "android", "emscripten"]

# The EXACT package identity, not a bare name: namespace omission means
# `mcpplibs` only, and mcpp's bare-name fallback is deprecated
# ("This fallback is removed in 2026.9"). {{self.name}} renders the selector,
# which carries the namespace.
[dependencies]
{{self.name}} = "{{self.version}}"

# The C++ standard library of the macOS and iOS rows, compiled for this
# application's own floors: on macOS it keeps the 12.0 floor CMake builds for
# (the toolchain's libc++ is built for 14.0), and on iOS it is the libc++ whose
# objects match its headers.
[target.'cfg(any(os = "macos", os = "ios"))'.dependencies]
llvm.libcxx = "22.1.8.3"

[targets.{{project.name}}]
# `app`: an executable on the desktop rows, the shared object the Java host
# loads on Android, a `.js` launcher on the Web.
kind = "app"
main = "src/main.cpp"
# No console window behind the application on Windows; inert elsewhere.
windows_subsystem = "windows"

# The interface this application's Setup.exe runs (windows/installer): a host
# tool of the Windows rows, built only when a build names the
# `windows-installer` feature -- `huxerui package windows` does, through
# `mcpp pack --format setup --features windows-installer` -- as CMake builds
# `<target>-Installer.exe` for a package build only.
[features]
windows-installer = []

[target.'cfg(os = "windows")'.feature-deps.windows-installer]
installer = { path = "windows/installer", tools = ["{{project.name}}-Installer"] }

[build]
# huxerui.rules owns the source selection: a build program can ADD a source but
# cannot replace one, so a package that also globbed src/**/*.cpp would link
# both the original and the transformed copy of every composable.
sources = []
# The platform floors a HuxerUI application builds for, as under CMake. The
# framework's version floors refuse a lower value.
macos_deployment_target = "12.0"
ios_deployment_target   = "15.0"

# The Windows executable's icon and the version metadata its Properties dialog
# shows. FILEVERSION, ProductName, FileDescription and CompanyName all default
# from [package], so this one line is the whole thing.
#
# ONLY PE TARGETS COMPILE THIS. On Linux and macOS the table is inapplicable --
# no resource units, no diagnostics, byte-identical build -- so it is written
# unconditionally and needs no cfg(windows) predicate. The file's existence IS
# checked on every target, which is what catches a typo on the Linux build
# rather than on the Windows one.
[resources]
icon = "assets/app.ico"

# The Web build's exception model; HuxerUI requires it, and only a root can
# state it.
[target.'cfg(os = "emscripten")'.abi]
exceptions = true

[target.x86_64-linux-android]
min_api_level = 23
[target.aarch64-linux-android]
min_api_level = 23
