// The whole build program: the composable transform and the resource
// compiler for this application, through the huxerui dependency's rule. The
// model under resources/raw/ becomes raw resources of the `app` namespace,
// which is what src/app.cppm names them by. Nothing here is about Live2D:
// the library's own build program deploys the shaders and bundles the Web
// bridge.

import mcpp;
import huxerui.rules;

int main() {
    return huxerui::rules::configure({
        .resources          = "resources",
        .resource_namespace = "app",
    }) ? 0 : 1;
}
