<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="icon" type="image/svg+xml" href="./{{name}}.favicon.svg">
  <link rel="apple-touch-icon" href="./{{name}}.apple-touch-icon.png">
  <title>{{title}}</title>
  <style>
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
    #huxerui-root { display: block; width: 100%; height: 100%; }
  </style>
</head>
<body>
  <div id="huxerui-root"></div>
  <script type="module">
    // The launcher is the MODULARIZE + EXPORT_ES6 build mcpp.toml's emscripten
    // section links, named after the target; the storage key scopes the
    // application's browser-managed files, and is its identifier.
    import createHuxerUIApp from "./{{name}}.js";

    const module = await createHuxerUIApp({
      huxeruiStorageKey: "{{storage_key}}",
    });
    await document.fonts.ready;
    const session = module.mountHuxerUI("#huxerui-root");
    if (!session) {
      throw new Error("HuxerUI Web session could not be mounted");
    }
  </script>
</body>
</html>
