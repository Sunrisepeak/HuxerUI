<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest huxerui.rules hands dist-apk for a HuxerUI application.

     The six tokens are the values only the build knows; everything else is
     the application manifest of the SDK's Gradle template
     (tools/huxerui_cli/templates/platform/android/app/app/src/main), which a
     CMake project's `huxerui create` writes: no permission, the same
     <application> and <activity> attributes. An application that needs more
     (the INTERNET permission HttpClient uses, URL schemes, a notification
     receiver) copies this file into its tree and names it with
     `.android = { .manifest_template }`, as a Gradle project edits its own.

     The launcher activity is the application's own `<application id>.MainActivity`,
     a subclass the rule generates that loads the application's shared object,
     exactly as a Gradle project's does; the framework's Java is the same under
     both build systems. `version_name` / `version_code` come from
     `[package] version`. `android:extractNativeLibs="false"` is what the
     Android Gradle plugin writes into the manifest it packages from minSdk 23:
     the libraries are loaded from the APK in place, stored uncompressed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{application_id}}"
    android:versionName="{{version_name}}"
    android:versionCode="{{version_code}}">
    <uses-sdk android:minSdkVersion="{{min_sdk}}" android:targetSdkVersion="{{target_sdk}}"/>
    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="{{label}}"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="{{activity}}"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
