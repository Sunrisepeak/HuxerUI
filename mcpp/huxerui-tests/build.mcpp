// The one input the support library needs that no manifest can name: the
// framework's builtin resource package, which tests/support/builtin_resources.cpp
// opens at HUXERUI_TEST_BUILTIN_RESOURCE_PACKAGE. CMake sets that definition to
// the package its own resource step produced; this runs the same hrc over the
// same framework resources and defines it to what it wrote.

import std;
import mcpp;
import huxerui.rules;
#include "resources.h"

int main() {
    std::string root, hrc;
    if (!huxerui_tests::locate(root, hrc)) return 1;
    mcpp::rerun_if_changed("resources.h");
    huxerui_tests::define_path("HUXERUI_TEST_BUILTIN_RESOURCE_PACKAGE", huxerui_tests::builtin_package(root, hrc));
    return 0;
}
