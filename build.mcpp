// HuxerUI's own build program.
//
// Three jobs, and deliberately no fourth:
//
//   1. The builtin resource header, which 11 of this project's translation
//      units #include and which therefore cannot be deferred to a consumer.
//   2. The Web link's JavaScript preludes, which need absolute paths.
//   3. Linux platform dependencies, resolved entirely from xlings payloads by
//      the rule package's probe.
//
// There is NO composable codegen here: `grep -r '[[huxerui::composable]]' src/
// platform/` finds nothing. huxerui_enable_codegen() is called only from
// cmake/HuxerUIApp.cmake (applications) and cmake/HuxerUILibraries.cmake (user
// libraries), so the framework's own build has never needed hcg.

import std;
import mcpp;
import huxerui.rules;

int main() {
    if (!huxerui::rules::builtin_resources()) return 1;

    // The Web link. The two JavaScript preludes are compiled into the launcher
    // by emcc and reach every consumer's link through link_flag; they are
    // named by absolute path because a link runs in the build directory, not
    // here. Everything else the row needs is in mcpp.toml's emscripten section.
    if (std::string_view(mcpp::target_os()) == "emscripten") {
        const std::string root = mcpp::manifest_dir();
        for (const char* js : { "/platform/web/web_platform_registry.js", "/platform/web/web_file.js" }) {
            const std::string path = root + js;
            mcpp::link_flag("--pre-js");
            mcpp::link_flag(path.c_str());
            mcpp::rerun_if_changed(path.c_str());
        }
        return 0;
    }

    // The Linux GTK stack, on this package's compile line and -- with `link`
    // -- on every consumer's final link. The probe lives in huxerui.rules so
    // that a library including GTK headers can run the same one; the payload
    // table it reads is the rule package's, and huxerui-build-check asserts it
    // matches the one mcpp.toml declares for this artifact. A no-op on every
    // row but the Linux desktop.
    return huxerui::rules::linux_gtk(/*link=*/true) ? 0 : 1;
}
