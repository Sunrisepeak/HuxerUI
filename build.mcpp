// HuxerUI's own build program.
//
// Two jobs, and deliberately no third:
//
//   1. Linux platform dependencies, resolved through pkg-config -- the same
//      .pc files cmake/platform/Linux.cmake reads with pkg_check_modules, so
//      this metadata cannot drift between the two build systems.
//   2. The builtin resource header, which 11 of this project's translation
//      units #include and which therefore cannot be deferred to a consumer.
//
// There is NO composable codegen here: `grep -r '[[huxerui::composable]]' src/
// platform/` finds nothing. huxerui_enable_codegen() is called only from
// cmake/HuxerUIApp.cmake (applications) and cmake/HuxerUILibraries.cmake (user
// libraries), so the framework's own build has never needed hcg.

import std;
import mcpp;
import huxerui.rules;

namespace {

// pkg-config's output, split into mcpp directives. `-l` and `-L` reach the
// final link, which is what puts GTK on an application's link line without the
// application naming it.
//
// THE INCLUDE DIRS GO IN AFTER THE SYSTEM ONES (`-idirafter`), NOT BEFORE.
// This is not a preference; `-I` here breaks the build outright.
//
// `pkg-config --cflags gtk4` on Debian/Ubuntu emits, among a dozen others,
//
//     -I/usr/include/x86_64-linux-gnu
//
// which is the SYSTEM glibc's multiarch directory. mcpp compiles with its own
// payload toolchain and its own glibc, and that glibc's <time.h> reaches its
// companion headers through <bits/time.h>. Put the system multiarch dir on
// `-I` and those `bits/` headers resolve to the SYSTEM's, so the payload's
// libstdc++ is compiled against two different glibcs at once:
//
//     .../xim-x-glibc/2.44/include/time.h:37
//       -> /usr/include/x86_64-linux-gnu/bits/time.h:73
//     error: 'time' has not been declared in '::'
//     error: 'struct timespec' has no member named 'tv_sec'
//     error: cannot convert '<brace-enclosed initializer list>' to 'unsigned int'
//                                             (__GTHREAD_COND_INIT)
//
// and every core translation unit fails -- not just the platform ones, because
// a build program's include dirs colour the whole package, exactly as
// huxerui_configure_compile_target() puts HUXERUI_PLATFORM_INCLUDE_DIRECTORIES
// on huxerui_core_objects. CMake does not hit this only because it uses the
// system compiler, whose glibc IS the system one.
//
// `-idirafter` keeps the toolchain's own header chain intact while leaving the
// GTK headers findable: they exist in no system directory, so nothing shadows
// them. Verified against gcc 16.1.0 + xim-x-glibc 2.44: `-I` fails, `-idirafter`
// compiles.
bool probe(std::string_view module_spec) {
    const std::string out = std::string(mcpp::out_dir()) + "/pkg-config.txt";
    const std::string cmd = "pkg-config --cflags --libs '" + std::string(module_spec)
                          + "' > '" + out + "' 2>/dev/null";
    if (std::system(cmd.c_str()) != 0) return false;

    std::ifstream in(out);
    if (!in) return false;
    std::string token;
    while (in >> token) {
        if (token.empty())                     continue;
        else if (token.starts_with("-I"))      mcpp::include_dir_after(token.substr(2).c_str());
        else if (token.starts_with("-l"))      mcpp::link_lib(token.substr(2).c_str());
        else if (token.starts_with("-L"))      mcpp::link_search(token.substr(2).c_str());
        // A linker flag is not a compile flag. pkg-config --libs can emit
        // -Wl,... and routing it to cxxflag would put it on every compile
        // line, where it is at best ignored and at worst rejected.
        else if (token.starts_with("-Wl,"))    mcpp::link_flag(token.c_str());
        else                                   mcpp::cxxflag(token.c_str());
    }
    return true;
}

} // namespace

int main() {
    if (!huxerui::rules::builtin_resources()) return 1;

    if (std::string_view(mcpp::target_os()) == "linux") {
        mcpp::rerun_if_env_changed("PKG_CONFIG_PATH");
        mcpp::rerun_if_env_changed("PKG_CONFIG_LIBDIR");

        // Version floors match cmake/platform/Linux.cmake.
        for (std::string_view m : { "gtk4 >= 4.14", "epoxy >= 1.5",
                                    "gio-2.0", "libsoup-3.0 >= 3.0" }) {
            if (!probe(m)) {
                std::cerr << "huxerui: pkg-config could not resolve '" << m
                          << "' -- install the distribution development package\n";
                return 1;
            }
        }
    }
    return 0;
}
